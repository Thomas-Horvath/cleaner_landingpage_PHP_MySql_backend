# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Add the database host here.
# Examples by environment:
# - local Docker: mysql
# - shared hosting / Nethely backend: localhost
DB_HOST=

# Add the database name here.
DB_NAME=

# Add the database user here.
DB_USER=

# Add the database password here.
DB_PASSWORD=

# Character set used by the MySQL connection.
# In most cases: utf8mb4
DB_CHARSET=

# -----------------------------------------------------------------------------
# Frontend origins
# -----------------------------------------------------------------------------
# Comma separated list of allowed frontend origins for CORS.
# Example:
# FRONTEND_ORIGINS=http://localhost:3000,https://your-frontend-domain.example
FRONTEND_ORIGINS=

# -----------------------------------------------------------------------------
# Mailer
# -----------------------------------------------------------------------------
# Available drivers:
# - log   : development mode, writes emails into a log file
# - mail  : PHP mail() transport
# - smtp  : direct SMTP connection
MAIL_DRIVER=

# Visible sender name.
MAIL_FROM_NAME=

# Visible sender email address.
MAIL_FROM_ADDRESS=

# Reply-to address used when the recipient clicks reply.
MAIL_REPLY_TO=

# Admin notification address for new booking alerts.
MAIL_ADMIN_TO=

# Relative path to the mail log file when MAIL_DRIVER=log
MAIL_LOG_PATH=

# SMTP host, for example your hosting provider's mail server.
MAIL_HOST=

# SMTP port, for example 465 for SSL or 1025/587 for TLS depending on provider.
MAIL_PORT=

# SMTP encryption mode.
# Common values:
# - ssl
# - tls
MAIL_ENCRYPTION=

# SMTP login username, usually a full email address.
MAIL_USERNAME=

# SMTP login password.
MAIL_PASSWORD=

# Timeout in seconds for SMTP connections.
MAIL_TIMEOUT=
